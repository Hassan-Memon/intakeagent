# ---------------------------------------------------------------------------
# IntakeAgent environment. Copy to .env and adjust. Never commit .env.
# Every value here has a safe default so `docker compose up` works with no keys.
# ---------------------------------------------------------------------------

# 1 = no external calls at all: scripted STT, rule-based extractor, mock exporters.
DEMO_MODE=1

# Database. docker-compose overrides this to the pgvector Postgres service.
# SQLite is used for tests and for a zero-dependency local run.
DATABASE_URL=sqlite:///./intakeagent.db

# --- LLM (used only when DEMO_MODE=0) --------------------------------------
# One of: auto | openinfer | ollama | groq | gemini | openrouter | stub
# "auto" = Ollama if reachable, else Groq if GROQ_API_KEY is set, else stub.
LLM_PROVIDER=auto
LLM_MODEL=llama-3.1-8b-instant
# OpenInfer (product 2) or any OpenAI-compatible endpoint. Requests carry the
# "private" tag so an OpenInfer router keeps them on local hardware.
OPENINFER_BASE_URL=
OPENINFER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Allow sending REDACTED transcripts to a non-local provider. Default off.
ALLOW_CLOUD_LLM=0

# --- Speech to text ----------------------------------------------------------
# One of: auto | stub | groq | faster_whisper
# "auto" = faster_whisper if installed, else groq if GROQ_API_KEY, else stub.
STT_PROVIDER=auto
FASTER_WHISPER_MODEL=base

# --- Exporters ---------------------------------------------------------------
# Set to 1 to POST the FHIR Bundle to the public HAPI sandbox (test data only).
FHIR_PUSH=0
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Clio API v4. Leave blank for mock mode. Regions: app.clio.com, eu.app.clio.com,
# ca.app.clio.com, au.app.clio.com.
CLIO_BASE_URL=https://app.clio.com
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://localhost:8000/oauth/clio/callback
CLIO_ACCESS_TOKEN=
CLIO_REFRESH_TOKEN=

# --- Web ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend reads these at build time. Use 127.0.0.1 rather than localhost: some browsers
# resolve localhost to IPv6 ::1 while uvicorn listens on IPv4 only, which surfaces as a
# confusing CORS preflight failure.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
